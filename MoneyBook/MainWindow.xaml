<Window
    x:Class="MoneyBook.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="가계부">
    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="나의 가계부" FontSize="30" FontWeight="SemiBold" />

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel><TextBlock Text="잔액" Opacity="0.7"/><TextBlock x:Name="BalanceText" Text="₩0" FontSize="24" FontWeight="SemiBold"/></StackPanel>
            </Border>
            <Border Grid.Column="1" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel><TextBlock Text="총수입" Opacity="0.7"/><TextBlock x:Name="IncomeText" Text="₩0" FontSize="24" Foreground="ForestGreen"/></StackPanel>
            </Border>
            <Border Grid.Column="2" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel><TextBlock Text="총지출" Opacity="0.7"/><TextBlock x:Name="ExpenseText" Text="₩0" FontSize="24" Foreground="IndianRed"/></StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <DatePicker x:Name="DateInput" />
            <ComboBox x:Name="TypeInput" Grid.Column="1" SelectedIndex="0" Header="구분">
                <ComboBoxItem Content="지출"/><ComboBoxItem Content="수입"/>
            </ComboBox>
            <TextBox x:Name="MemoInput" Grid.Column="2" Header="내용" PlaceholderText="예: 점심 식사" />
            <NumberBox x:Name="AmountInput" Grid.Column="3" Header="금액" Minimum="0" SpinButtonPlacementMode="Compact" />
            <Button Grid.Column="4" Content="추가" VerticalAlignment="Bottom" Click="Add_Click" />
        </Grid>

        <Grid Grid.Row="3" RowSpacing="8">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid ColumnSpacing="8">
                <TextBlock Text="거래 내역" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Content="선택 삭제" HorizontalAlignment="Right" Click="Delete_Click" />
            </Grid>
            <ListView x:Name="TransactionList" Grid.Row="1" SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="15" Margin="4" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Window>
